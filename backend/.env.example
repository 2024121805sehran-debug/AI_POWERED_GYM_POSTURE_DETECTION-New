# Firebase Admin SDK Configuration
# Choose ONE of the following methods to provide Firebase credentials:

# Option 1: Provide the full service account JSON as a string (recommended for production)
# Copy the entire contents of your service account JSON file as a single-line string
# FIREBASE_SERVICE_ACCOUNT={"type":"service_account","project_id":"...",...}

# Option 2: Provide the path to your service account JSON file (for local development)
# For development purposes, the project includes a placeholder file with the original credentials.
# IMPORTANT: Replace this with your own Firebase credentials for security.
# The placeholder file contains the original project credentials and should be replaced.
FIREBASE_SERVICE_ACCOUNT_PATH=serviceAccountKey.json.placeholder

# CORS Configuration
# Comma-separated list of allowed origins for development
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001

# Camera Configuration (optional)
# CAMERA_INDEX=0
# CAMERA_WIDTH=640
# CAMERA_HEIGHT=480
# CAMERA_FPS=30

# MediaPipe Configuration (optional)
# MEDIAPIPE_MODEL_COMPLEXITY=0
# MEDIAPIPE_MIN_DETECTION_CONFIDENCE=0.5
# MEDIAPIPE_MIN_TRACKING_CONFIDENCE=0.5
